{
  "name": "@mavis/durable-backend-sqlite-zstd",
  "version": "0.1.0",
  "description": "Durable delta-log storage backend: immutable zstd-compressed entry batches in SQLite (WAL, synchronous=FULL) with format generations and a pluggable zstd/gzip codec.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./codec": {
      "types": "./src/codec.ts",
      "import": "./dist/codec.js"
    }
  },
  "typesVersions": {
    "*": {
      "codec": [
        "src/codec.ts"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=22.15"
  },
  "private": true,
  "license": "MIT"
}
